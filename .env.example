# Copy to .env and fill
# Database — Supabase free tier for prod, local Postgres for docker-compose
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aura
# Alternatives:
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_KEY=eyJ...

# LLM — choose one provider, $0 free tier
LLM_PROVIDER=mock
# groq | gemini | mock (mock streams canned text without API key, perfect for portfolio demo)
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...

# Model names
GROQ_MODEL=llama3-8b-8192
GEMINI_MODEL=gemini-1.5-flash
# Embeddings are always Gemini, even when LLM_PROVIDER=groq. Without a working
# GEMINI_API_KEY, ingest and retrieval fall back to TF-IDF and pgvector is unused.
GEMINI_EMBED_MODEL=models/gemini-embedding-001
# Must match the Vector(...) width of chunks.embedding, which reads this value.
EMBED_DIM=768

# RAG
# Similarity floor in pgvector mode.
RETRIEVAL_THRESHOLD=0.85
# Separate floor for the TF-IDF fallback -- sparse and dense cosine scores are not
# on the same scale. GET /health reports which mode is active.
TFIDF_THRESHOLD=0.10
TOP_K=5
CHUNK_SIZE=600
# Must be < CHUNK_SIZE; it is clamped if not.
CHUNK_OVERLAP=100
MAX_PDF_MB=50

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Sent as X-API-Key when the backend runs with ENABLE_AUTH=true. NEXT_PUBLIC_* is
# inlined into the client bundle and is therefore public -- demo keys only. A real
# deployment needs a session/token flow where the browser holds no shared secret.
NEXT_PUBLIC_API_KEY=

# Security
LOG_QUERIES=false
# Leave unset to allow all origins without credentials. Setting it enables
# credentialed CORS restricted to these origins.
CORS_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app
# When true, every request needs a matching X-API-Key from API_KEYS below.
# Enabling this with an empty API_KEYS fails closed (503), it does not open up.
# Note: the frontend does not currently send a key.
ENABLE_AUTH=false
API_KEYS=
